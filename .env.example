# Server only. Never prefix a secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
EASYBATT_ADMIN_PASSWORD=

# Customer accounts: enable only after the customers migration, SMTP and privacy setup.
EASYBATT_AUTH_ENABLED=0
SUPABASE_PUBLISHABLE_KEY=
EASYBATT_PRIVACY_URL=

# Project requests: disabled until the SQL migration and approved privacy notice are ready.
# Use a separate, random secret of at least 32 characters (server only).
EASYBATT_PROJECTS_ENABLED=0
EASYBATT_PROJECTS_SECRET=
EASYBATT_PROJECTS_PRIVACY_VERSION=

# Existing Google Maps configuration remains unchanged.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EASYBATT_ORIGIN_LAT=
EASYBATT_ORIGIN_LNG=
EASYBATT_ORIGIN_LABEL=
